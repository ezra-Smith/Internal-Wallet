{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/.umi",
      "!**/.umi-production",
      "!**/.umi-test",
      "!**/.umi-test-production",
      "!**/src/api/generated",
      "!**/src/services",
      "!**/mock",
      "!**/dist",
      "!**/server",
      "!**/public",
      "!**/coverage",
      "!**/node_modules",
      "!biome.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@/api/accounting": "Forbidden: use `@/api/generated/accounting` generated by `bun run generate:api`.",
              "@/api/blacklist": "Forbidden: use `@/api/generated/blacklist` generated by `bun run generate:api`.",
              "@/api/currencies": "Forbidden: use `@/api/generated/assets` generated by `bun run generate:api`."
            }
          }
        }
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useValidAnchor": "off",
        "useKeyWithClickEvents": "off"
      }
    }
  },
  "javascript": {
    "jsxRuntime": "reactClassic",
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
