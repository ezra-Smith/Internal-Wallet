{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSwaggerPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::internal-wallet-artifacts-301918028034",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "swagger/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteSwaggerObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::internal-wallet-artifacts-301918028034/swagger/*"
    },
    {
      "Sid": "ReadSwaggerObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::internal-wallet-artifacts-301918028034/swagger/*"
    }
  ]
}
