  "paths": {
    "/api/v1/swap/my/configs": {
      "get": {
        "summary": "查询我的Swap配置",
        "description": "业务端查询自己项目的生效Swap配置（从API Key自动获取项目名称）",
        "operationId": "Swap_GetMySwapConfigs",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/GatewayUnifiedResponse_swapSwapGetMySwapConfigsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "provider",
            "description": "不需要 project_name，从 API Key context 自动获取\n\n服务商代码（可选过滤，例如 \"1inch\", \"okx\"）",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "chain_id",
            "description": "链ID（可选过滤）",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "page",
            "description": "页码",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_size",
            "description": "每页条数",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "Swap"
        ]
      }
    }
  },
