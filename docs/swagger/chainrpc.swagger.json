{
  "swagger": "2.0",
  "info": {
    "title": "chainrpc.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "ChainGas",
      "description": "Gas 费用估算与价格查询"
    },
    {
      "name": "ChainQuery",
      "description": "链上数据查询（余额、交易状态、区块等）"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/chain/gas/estimate": {
      "post": {
        "summary": "估算交易 Gas Limit",
        "description": "估算单笔交易的 Gas Limit 和当前费用（适用于后台系统和精确计算场景，不推荐移动端使用）",
        "operationId": "ChainRPC_EstimateGas",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/GatewayUnifiedResponse_chainrpcEstimateGasResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/chainrpcEstimateGasReq"
            }
          }
        ],
        "tags": [
          "ChainGas"
        ]
      }
    },
    "/api/v1/chain/gas/price": {
      "post": {
        "summary": "获取分级 Gas 价格",
        "description": "获取不同速度级别的 Gas 价格（慢/标准/快/极速），包含预估确认时间和 Gwei 价格。适用于 Swap 交易设置等场景（ETH/BSC）",
        "operationId": "ChainRPC_GetGasPrice",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/GatewayUnifiedResponse_chainrpcGetGasPriceResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/chainrpcGetGasPriceReq"
            }
          }
        ],
        "tags": [
          "ChainGas"
        ]
      }
    },
    "/api/v1/chain/tron/account-resources/{address}": {
      "get": {
        "summary": "查询 TRON 地址资源",
        "description": "Query TRON address resources (bandwidth, energy, balance)",
        "operationId": "ChainRPC_GetTronAccountResources",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/GatewayUnifiedResponse_chainrpcGetTronAccountResourcesResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "address",
            "description": "TRON address to query (Base58 format)",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ChainQuery"
        ]
      }
    },
    "/api/v1/chain/tron/estimate-fee": {
      "post": {
        "summary": "估算 TRON 手续费",
        "description": "Estimate TRON transaction fee (bandwidth + energy + activation)",
        "operationId": "ChainRPC_EstimateTronFee",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/GatewayUnifiedResponse_chainrpcEstimateTronFeeResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/chainrpcEstimateTronFeeReq"
            }
          }
        ],
        "tags": [
          "ChainGas"
        ]
      }
    }
  },
